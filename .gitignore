# jsdom is an optional dev dependency for the browser-integration tests only.
# The extension itself has no runtime dependencies and ships unbundled.
node_modules/
package-lock.json

# Scratch
*.log
.DS_Store

# Store packages built by `npm run package`. Build output is regenerable and
# stays out of the repository — with one deliberate exception below: the exact
# archive submitted to the Chrome Web Store, kept so the uploaded bytes can be
# identified later. A zip does not delta-compress, so every committed build
# adds its full size to history permanently.
#
# ONE archive is tracked: the current release. Superseded ones are untracked
# rather than accumulated — they had grown to four, 7.8 MB, of which three
# were superseded within hours and none should be uploaded. Removing them
# loses nothing: their bytes are already permanent in history, so an old
# release can still be recovered exactly.
#
#   git show <commit>:dist/cadastral-digitizer-17.4.0.zip > recovered.zip
#
# On a new release, replace the line below rather than adding to it.
dist/*
!dist/cadastral-digitizer-17.5.0.zip
