# jsdom is an optional dev dependency for the browser-integration tests only.
# The extension itself has no runtime dependencies and ships unbundled.
node_modules/
package-lock.json

# Scratch
*.log
.DS_Store

# Store packages built by `npm run package`. Build output is regenerable and
# stays out of the repository — with one deliberate exception below: the exact
# archive submitted to the Chrome Web Store, kept so the uploaded bytes can be
# identified later. Each release that is worth keeping needs its own line here,
# rather than tracking every rebuild: a zip does not delta-compress, so every
# committed build adds its full size to history permanently.
dist/*
!dist/cadastral-digitizer-17.3.3.zip
!dist/cadastral-digitizer-17.3.4.zip
!dist/cadastral-digitizer-17.4.0.zip
